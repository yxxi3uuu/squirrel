{
  "name": "SquirrelAdvisor",
  "version": "1.0.0",
  "description": "城市應變 AI 策略諮詢顧問 — What-if SOP 判斷",
  "agents": {
    "SquirrelAdvisor": {
      "language": "Python",
      "framework": "Strands",
      "modelProvider": "Bedrock",
      "entrypoint": "app/SquirrelAdvisor/main.py",
      "runtime": {
        "requestHeaderAllowlist": [
          "X-Amzn-Bedrock-AgentCore-Runtime-Custom-User-Id",
          "Authorization"
        ]
      }
    }
  }
}
