# Copy this file to .env for local development.
# Never commit real API keys or AWS credentials.

# mock: offline demo, no API key required
# anthropic: local LLM development with Anthropic API
# bedrock: AWS Bedrock runtime
LLM_MODE=mock

# Module 3 mock demo only.
# Empty = enabled only when LLM_MODE=mock.
# Set false/off/0 when another module already provides a real dashboard snapshot.
MODULE3_USE_DEMO_SNAPSHOT=

# Anthropic mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Bedrock mode
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional. Use when AWS requires an inference profile prefix.
# Examples: us, global, eu, apac
BEDROCK_INFERENCE_PREFIX=

# Retry Bedrock throttling / quota errors
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_DELAY_SECONDS=2
